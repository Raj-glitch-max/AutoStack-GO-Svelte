# AutoStack Environment Configuration
# Copy this file to .env and fill in the values

# CRITICAL: Encryption key for AWS credentials and secrets
# Generate with: openssl rand -base64 32
# WARNING: Never change this after first deployment - all encrypted data will become unreadable
AUTOSTACK_ENCRYPTION_KEY=

# PocketBase Admin Email (for initial setup)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# AWS Integration (optional)
AWS_INTEGRATION_ENABLED=true

# Local Development
LOCAL=true
LOCAL_KUBECONFIG_FILE=/root/.kube/config

# Infracost API Key (for AWS cost estimation)
# Sign up at: https://www.infracost.io/
# Free tier: 100 estimates/month
INFRACOST_API_KEY=your_infracost_api_key_here

# Resend API Key (for email notifications)
# Sign up at: https://resend.com/
# Free tier: 3,000 emails/month
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev

# Claude API Key (for AI features) — legacy, superseded by NVIDIA below
CLAUDE_API_KEY=your_claude_api_key_here

# NVIDIA AI API (used for all AI features: Advisor, Recovery, Optimizer, Explainer)
# Model: nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
# Sign up at: https://integrate.api.nvidia.com/
NVIDIA_API_KEY=nvapi-your_nvidia_api_key_here
NVIDIA_MODEL=deepseek-ai/deepseek-v4-pro
NVIDIA_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
